<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validation_Type_Holiday</fullName>
    <active>true</active>
    <errorConditionFormula>AND ( ISPICKVAL(Type__c , &apos;Holiday&apos;), OR ( ISBLANK(Start_Date_Time__c), ISBLANK(End_Date_Time__c)))</errorConditionFormula>
    <errorMessage>Please Input Start Date &amp; Time and End Date Time</errorMessage>
</ValidationRule>
